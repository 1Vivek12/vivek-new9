# ==============================================================================
# NEWS 9 AI CONTENT & NEWSROOM AUTOMATION PLATFORM - CONFIGURATION TEMPLATE
# Phase 1: Multi-Tenant Production Foundation
# Note: Use placeholders only. Never commit real credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="News 9 AI Content & Newsroom Automation Platform"
APP_VERSION="1.0.0-phase1"
API_V1_PREFIX="/api/v1"
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Security & Authentication (Generate secure secret in production, e.g. `openssl rand -hex 32`)
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/news9_platform"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_TIMEOUT=30

# Redis & Broker Configuration (Celery)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Storage Configuration (Local directory for Phase 1)
STORAGE_ROOT="./data/storage"

# AI Provider Configuration (Local Inference Target: Ollama)
AI_PROVIDER_TYPE="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="llama3"
OLLAMA_REQUEST_TIMEOUT=60

# Agent Runtime Configuration (Sandboxed / Internal)
AGENT_RUNTIME_TYPE="prime_agent"
AGENT_EXECUTION_ENABLED=false
AGENT_TIMEOUT_SECONDS=120

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
